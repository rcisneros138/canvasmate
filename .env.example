# CanvasMate environment variables.
#
# Local dev: copy to .env (only if you want to override defaults — the app
# runs fine with no env at all, using the ConsoleMailer that prints magic
# links to stdout).
#
# Production: set these via `fly secrets set KEY=value` (or your platform's
# equivalent). Never commit real secrets.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public origin used in magic-link emails. Must match the URL the browser
# actually loads. In dev, leave unset and the server defaults to
# http://localhost:5174 (Vite's port).
APP_URL=https://canvasmate.org

# Set to "true" or "1" behind a reverse proxy / Fly's edge so req.ip uses
# X-Forwarded-For (rate-limiting depends on this being accurate).
TRUST_PROXY=true

# --- Email (Resend) ---------------------------------------------------------
# Get an API key at https://resend.com/api-keys. Verify your sending domain
# first (SPF + DKIM DNS records), or send-to-self will be the only thing that
# works. When this is unset, the server falls back to logging magic links to
# stdout — fine for dev, NEVER deploy without it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=CanvasMate <noreply@canvasmate.org>

# --- Bot guard (Cloudflare Turnstile) ---------------------------------------
# Create a site at https://dash.cloudflare.com → Turnstile → Add site. You get
# two keys: the public site key (sent to the browser) and the secret (kept on
# the server). Both must be set together — if either is missing, the CAPTCHA
# is silently skipped.
TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SITE_KEY=0x4AAAAAAAyyyyyyyyyyyyyyyyyyyyyyyyyy
